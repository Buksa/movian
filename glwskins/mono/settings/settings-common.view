#import "skin://include/buttons.view"

#define settingGroup(BODY) {
  widget(backdrop, {
    .source = "skin://graphics/border-tiny.png";
    .border = 4;
    .padding = -2;
    .color = 0.5;
    BODY;
  });
}

#define settingButtonUp(EVENT, ENABLED, HIDDEN) {
  _glossybutton(ICON="skin://svg/ArrowUp.svg",
		EVENT=EVENT,
		ENABLED=ENABLED,
		HIDDEN=HIDDEN);
}

#define settingButtonDown(EVENT, ENABLED, HIDDEN) {
  _glossybutton(ICON="skin://svg/ArrowDown.svg",
		EVENT=EVENT,
		ENABLED=ENABLED,
		HIDDEN=HIDDEN);
}

#define settingButtonAction(CAPTION, EVENT, ENABLED, HIDDEN) {
  _glossybuttonTextRight(ICON="skin://svg/Command.svg",
			 CAPTION=CAPTION,
			 EVENT=EVENT,
			 ENABLED=ENABLED,
			 HIDDEN=HIDDEN);
}
