widget(image, {
  .color = 0.5 + isHovered() * 0.4 + isFocused() * 0.4 + isPressed() * 0.4;
  .source = $self.metadata.icon ?? 
    "skin://svg/" + 
    translate($self.type, "Folder.svg",
              "music",     "Music.svg",
              "plugin",    "Plugin.svg",
              "video",     "Movie.svg",
              "tv",        "Display.svg",
              "photos",    "Pictures.svg");

  .alpha = iir(isLoaded() || isError(), 10);
  .saturation = 1 - iir(isLoaded() || isError(), 10);

});
