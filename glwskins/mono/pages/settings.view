#include "skin://include/separators.view"
#include "skin://include/slider.view"
#include "skin://include/listitems.view"

widget(container_y, {
  .padding = $ui.size / 2;
  .alpha = 1 - iir(clamp(getLayer(), 0, 1), 7) * 0.5;
  .blur  = iir(clamp(getLayer(), 0, 1), 7);

  widget(container_x, {

    widget(dummy, { .width = 2; });

    widget(list_y, {
      .id = "list";
      .spacing = 5;
      LIST_ITEM_SIMPLE("Add new entry",
		       "skin://svg/Add.svg",
		       {
			 createChild($self.model.nodes);
		       },
		       [0.3, 0.5, 0.3],
		       0.8,
		       !$self.model.mayadd);


      cloner($self.model.nodes, loader, {
	.alt = "skin://settings/settings.view";
	.source = "skin://settings/" + $self.type + ".view";
	.time = 0.3;
	.noInitialTransform = true;
      });

    });

    widget(dummy, { .width = 2; });
    LIST_Y_SLIDER("list");
    widget(dummy, { .width = 2; });
  });
  widget(dummy, {
    .height = $ui.playdeckheight;
  });
});