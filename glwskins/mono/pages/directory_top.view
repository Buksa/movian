#import "skin://include/nav.view"

$view.canSlideShow = $self.model.contents == "images";
$view.canCoverFlow = ($self.model.contents == "images" ||
		      $self.model.contents == "albums");

$self.glw.curView = $self.glw.userView ?? $self.requestedView ??
  translate($self.model.contents, select($ui.list2, "list2", "list"),
	    "items", "array",
	    "albums", "coverflow",
	    "images", "coverflow");

widget(container_x, {
  skinNavLocation($self.model.metadata.title, $self.model.metadata.logo);
  skinNavSelection(select($ui.list2, "list2", "list"), true);
  skinNavSelection("array", true);
  skinNavSelection("coverflow", $view.canCoverFlow);
  skinNavSelection("slideshow", $view.canSlideShow);
});
