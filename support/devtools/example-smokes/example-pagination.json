{
  "name": "example-pagination",
  "describe": "The append-more paginator renders its first page.",
  "needs": {
    "binary": "build.debug/movian",
    "plugin": "../../../plugin_examples/02-intermediate/05-pagination"
  },
  "steps": [
    {
      "do": "health"
    },
    {
      "do": "open",
      "url": "example:paginate:append"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/metadata/title",
      "equals": "Append More Pattern"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/nodes",
      "equals": 4
    }
  ]
}
