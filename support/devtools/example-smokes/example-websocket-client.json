{
  "name": "example-websocket-client",
  "describe": "The menu renders. It does NOT open a socket -- connecting is bound to an action, and wss:// does not work on a PolarSSL build anyway (#213).",
  "needs": {
    "binary": "build.debug/movian",
    "plugin": "../../../plugin_examples/03-advanced/01-websocket-client"
  },
  "steps": [
    {
      "do": "health"
    },
    {
      "do": "open",
      "url": "example:websocket:"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/metadata/title",
      "equals": "WebSocket Demo"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/nodes",
      "equals": 2
    }
  ]
}
