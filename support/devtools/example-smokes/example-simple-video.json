{
  "name": "example-simple-video",
  "describe": "Three video items are appended.",
  "needs": {
    "binary": "build.debug/movian",
    "plugin": "../../../plugin_examples/01-basic/02-simple-video"
  },
  "steps": [
    {
      "do": "health"
    },
    {
      "do": "open",
      "url": "example:video:"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/metadata/title",
      "equals": "Video Examples"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/nodes",
      "equals": 3
    }
  ]
}
