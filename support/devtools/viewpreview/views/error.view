// Self-contained fallback view for viewpreview errors: no #import of any
// skin file, so it renders even if the skin can't be resolved. Bound
// directly to $self (the page prop -- see README.md "path scheme
// findings" for why this is $self and not $args/$parent).

widget(container_z, {

  widget(quad, {
    color: [0.15, 0, 0];
    alpha: 0.95;
  });

  widget(container_y, {
    align: center;
    padding: 2em;

    widget(label, {
      caption: "viewpreview error";
      size: 2em;
      color: [1, 0.6, 0.6];
      align: center;
    });

    widget(label, {
      caption: $self.model.metadata.viewpreviewError ?? "(no message)";
      size: 1.2em;
      color: [1, 1, 1];
      align: center;
      maxlines: 10;
    });
  });
});
