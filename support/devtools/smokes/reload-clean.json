{
  "name": "reload-clean",
  "describe": "Reload the GLW universe without any GLW error.",
  "needs": {
    "plugin": null,
    "binary": "build.debug/movian"
  },
  "steps": [
    {
      "do": "reload",
      "js": false
    },
    {
      "do": "assert_log",
      "must_not_match": "GLW\\s+\\[ERROR\\]"
    }
  ]
}
