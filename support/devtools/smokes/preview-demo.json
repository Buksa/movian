{
  "name": "preview-demo",
  "describe": "Render the 12-node demo view cleanly and capture it.",
  "needs": {
    "plugin": "support/devtools/viewpreview",
    "binary": "build.debug/movian"
  },
  "steps": [
    {
      "do": "preview",
      "view": "support/devtools/viewpreview/views/demo-list.view",
      "fixture": "support/devtools/viewpreview/fixtures/directory-nodes.json"
    },
    {
      "do": "assert_log",
      "must_not_match": "(?:GLW\\s+\\[ERROR\\]|viewpreview:\\s*ERROR:)"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/nodes",
      "equals": 12
    },
    {
      "do": "shot",
      "tag": "demo"
    }
  ]
}
