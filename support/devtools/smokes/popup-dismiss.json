{
  "name": "popup-dismiss",
  "describe": "A parked route reaches page-ready, and a popup offering cancel is declined rather than confirmed.",
  "needs": {
    "plugin": "support/devtools/popup_test_plugin",
    "binary": "build.debug/movian"
  },
  "steps": [
    {
      "do": "open",
      "url": "popuptest:clean"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/metadata/title",
      "equals": "no popup here"
    },
    {
      "do": "open",
      "url": "popuptest:blocking"
    },
    {
      "do": "assert_log",
      "must_match": "popuptest242: blocking route resumed"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/metadata/title",
      "equals": "popup dismissed"
    },
    {
      "do": "assert_prop",
      "path": "global/popups",
      "equals": 0
    },
    {
      "do": "open",
      "url": "popuptest:cancelable"
    },
    {
      "do": "assert_log",
      "must_match": "cancelable route resumed, answer=false"
    },
    {
      "do": "assert_prop",
      "path": "global/navigators/current/currentpage/model/metadata/title",
      "equals": "declined"
    }
  ]
}
